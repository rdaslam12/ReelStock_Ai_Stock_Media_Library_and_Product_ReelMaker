# Copy this to .env and fill in your values
# Then load with: export $(cat .env | xargs)

# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production
DJANGO_SITE_ID=1
ACCOUNT_EMAIL_VERIFICATION=optional

# Social login is configured with django-allauth SocialApp rows in Django admin.
# Google needs this callback URL:
#   https://your-domain.com/accounts/google/login/callback/
# Store provider client IDs/secrets in the SocialApp admin entries, not in code.

# HuggingFace — for text-to-image generation on the Generate page
# Get your token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=  # e.g. "hf_yourtokenhere" – leave blank to disable AI scene generation
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_TIMEOUT=60

# Fal.ai — for image-to-video (product reel) generation on the Reel Maker page
# Get your key at: https://fal.ai/dashboard/keys
FAL_API_KEY=  # optional – only needed if using fal.ai text-to-video API

# Email notifications
# Defaults to console email unless DJANGO_EMAIL_BACKEND is changed.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ReelStock Admin <noreply@reelstock.local>
ADMIN_CONTACT_EMAIL=admin@reelstock.local
